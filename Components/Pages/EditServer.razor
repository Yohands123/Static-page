@page "/edit-server/{Index:int}"
@using BlazorSSRApp.Data
@using BlazorSSRApp.Models
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Nav

<h3>Edit Server</h3>

@if (original is null)
{
    <div class="alert alert-danger">Server not found.</div>
}
else
{
    <EditForm Model="edit"
              OnValidSubmit="HandleValidSubmit"
              FormName="EditServerForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card p-4 w-50">
            <div class="mb-3">
                <label for="NameEdit" class="form-label">Server Name</label>
                <InputText id="NameEdit"
                           class="form-control"
                           @bind-Value="edit.Name" />
                <ValidationMessage For="@(() => edit.Name)" />
            </div>

            <div class="mb-3">
                <label for="CityEdit" class="form-label">City</label>
                <InputSelect id="CityEdit"
                             class="form-control"
                             @bind-Value="edit.City">
                    <option value="">-- select --</option>
                    @foreach (var c in Cities)
                    {
                        <option value="@c">@c</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => edit.City)" />
            </div>

            <div class="d-flex">
                <button type="submit" class="btn btn-success me-2">Save</button>
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="Cancel">
                    Cancel
                </button>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Index { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    private Server? original;
    private Server edit = new();

    private static readonly List<string> Cities =
      new() { "Toronto", "Montreal", "Ottawa", "Calgary", "Halifax" };

    protected override void OnInitialized()
    {
        if (Index >= 0 && Index < ServerStore.Servers.Count)
        {
            original = ServerStore.Servers[Index];
            edit = new Server
            {
                Name = original.Name,
                City = original.City,
                IsOnline = original.IsOnline,
                PeopleOnline = original.PeopleOnline
            };
        }
    }

    private void HandleValidSubmit()
    {
        if (original is not null)
        {
            original.Name = edit.Name;
            original.City = edit.City;
        }
        Nav.NavigateTo($"/manage?search={Uri.EscapeDataString(Search ?? "")}");
    }

    private void Cancel() =>
      Nav.NavigateTo($"/manage?search={Uri.EscapeDataString(Search ?? "")}");
}
