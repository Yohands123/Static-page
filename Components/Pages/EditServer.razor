@page "/edit-server/{id:int}"
@using BlazorSSRApp.Data
@using BlazorSSRApp.Models
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation

<h3>Edit Server</h3>

@if (server is null)
{
    <div class="alert alert-danger">Server not found.</div>
}
else
{
    <EditForm Model="server"
              OnValidSubmit="Save"
              FormName="EditServerForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <InputNumber @bind-Value="server.Id" hidden></InputNumber>
        <div class="card p-4 w-50">
            <div class="mb-3">
                <label class="form-label">Server Name</label>
                <InputText class="form-control" @bind-Value="server.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label">City</label>
                <InputSelect class="form-control" @bind-Value="server.City">
                    <option value="">-- select a city --</option>
                    @foreach (var c in Cities)
                    {
                        <option value="@c">@c</option>
                    }
                </InputSelect>
            </div>
            <div class="d-flex">
                <button type="submit" class="btn btn-success me-2">Save</button>
                <button type="button" class="btn btn-secondary" @onclick="Cancel">
                    Cancel
                </button>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] 
    public int Id { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromForm()]
    private Server? server { get; set; }

    private static readonly List<string> Cities = new()
      { "Toronto", "Montreal", "Ottawa", "Calgary", "Halifax" };

    protected override void OnParametersSet()
    {
        server ??= ServerStore.Servers[Id];
    }

    private async Task Save()
    {

        if(server is not null)
        {
            ServerStore.Update(server);
        }

        await Task.Yield();
        Navigation.NavigateTo("/servers");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/servers");
    }
}
