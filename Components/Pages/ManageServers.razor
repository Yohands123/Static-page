@page "/manage-servers"
@page "/servers"
@using BlazorSSRApp.Data
@using BlazorSSRApp.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@inject ILogger<ManageServers> Logger

<h2>Servers</h2>
<hr />

@{
    var allCities = new[] { "Toronto", "Montreal", "Ottawa", "Calgary", "Halifax" };
}

<div class="d-flex flex-wrap mb-3">
    @foreach (var city in allCities)
    {
        <CityCardComponent CityName="@city"
                           ServerCount="@CountOnlineByCity(city)"
                           OnClick="() => ApplyFilter(city)" />
    }
</div>

<div class="input-group mb-3 w-25">
    <input class="form-control"
           placeholder="Search Servers"
           @bind="filter" />
    <button class="btn btn-outline-secondary"
            @onclick="() => ApplyFilter(filter)">
        Search
    </button>
</div>

<table class="table table-bordered table-hover table-striped">
    <thead class="table-primary">
        <tr>
            <th>Name</th>
            <th>City</th>
            <th>Status</th>
            <th>People Online</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Filtered)
        {
            <tr class="align-middle">
                <td>@s.Name</td>
                <td>@s.City</td>
                <td style="color:@(s.IsOnline ? "green" : "red")">
                    @(s.IsOnline ? "online" : "offline")
                </td>
                <td>@(s.IsOnline? s.PeopleOnline.ToString() : "N/A")</td>
                <td>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => Delete(s)">
                            Delete
                        </button>
                        <NavLink class="btn btn-sm btn-outline-primary"
                                 href="@($"/server/{s.Id}")">
                            Edit
                        </NavLink>
                        <button class="btn btn-sm @(s.IsOnline ? "btn-warning" : "btn-success")"
                                @onclick="() => Toggle(s)">
                            @(s.IsOnline ? "Turn Off" : "Turn On")
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<NavLink class="btn btn-primary mt-3" href="/server">
    Add Server
</NavLink>

@code {
    private string filter = string.Empty;

    IEnumerable<Server> Filtered =>
      ServerStore.Servers.Where(s =>
        string.IsNullOrWhiteSpace(filter)
        || s.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
        || s.City.Contains(filter, StringComparison.OrdinalIgnoreCase)
      );

    void ApplyFilter(string f) => filter = f;
    void Delete(Server s) => ServerStore.Servers.Remove(s);

    void Toggle(Server s)
    {
        s.IsOnline = !s.IsOnline;
        if (!s.IsOnline) s.PeopleOnline = 0;
    }

    int CountOnlineByCity(string city) =>
      ServerStore.Servers.Count(s => s.City == city && s.IsOnline);
}